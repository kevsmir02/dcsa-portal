* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore

# Stored with CRLF as-is, so the raw GitHub download is CRLF too -- cmd.exe
# can misread labels in a batch file with bare LF line endings.
*.bat -text
